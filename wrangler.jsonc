{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare のダッシュボードの Worker 名と一致させる（自動デプロイの条件）
  "name": "checkinmanagement",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  // https://checkinmanagement.<サブドメイン>.workers.dev で公開する
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    // 画面（React）は Static Assets から配信する。API と Google ログインだけ Worker を通す
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tamahouse-checkin",
      "database_id": "bbcdeaed-885c-40c1-97b3-5c13d8477493",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // 通知メールの送信に使う Google アカウント（要件定義書 F21）
    "GOOGLE_SERVICE_EMAIL": "tamahouse0930@gmail.com",
    // 写真の保存（Google ドライブ）に使う Google アカウント（要件定義書 F21）
    "GOOGLE_DRIVE_EMAIL": "s.tamaki@tmkjp.com",
    // 定期処理の通知メールに載せる管理画面の URL の起点
    "PUBLIC_ORIGIN": "https://checkinmanagement.tamahouse0930.workers.dev"
  },
  // 接続元の IP ごとの回数制限（設計書 7.2）。namespace_id はアカウントの中で重ならない数字にする
  "ratelimits": [
    {
      // ログインしていない人も呼べる API 全体。同じ Wi-Fi の宿泊者 20 人が同時に入力しても足りる回数にする
      "name": "PUBLIC_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      // タブレットの端末登録（8 桁のコード）
      "name": "PAIR_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
